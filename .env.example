# Copy this file to .env and fill in your own values.
# Never commit .env.

# Any OpenAI-compatible endpoint works: DeepSeek, DashScope compatible mode,
# OpenAI, Moonshot, vLLM, Ollama (/v1), etc.
JAILFORGE_BASE_URL=https://api.deepseek.com/v1
JAILFORGE_MODEL=deepseek-chat
JAILFORGE_API_KEY=sk-your-key-here

# Optional: judge model (defaults to the target model)
# JAILFORGE_JUDGE_MODEL=deepseek-chat
